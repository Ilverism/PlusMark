{
	"name": "plusmark",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"build:emoji": "tsx scripts/build-reaction-emoji.ts",
		"dev": "vite dev",
		"build": "wrangler types --include-runtime false && node scripts/patch-worker-types.js && vite build && node scripts/export-durable-objects.js",
		"preview": "wrangler dev build/cloudflare/_worker.js --port 4173 --var TURNSTILE_HOSTNAME:localhost",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --include-runtime false && node scripts/patch-worker-types.js && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"test:e2e": "playwright install && playwright test",
		"test": "npm run test:e2e",
		"gen": "wrangler types --include-runtime false && node scripts/patch-worker-types.js",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/noto-sans": "^5.3.0",
		"@inlang/paraglide-js": "latest",
		"@internationalized/date": "^3.12.4",
		"@libsql/client": "^0.17.4",
		"@playwright/test": "^1.64.0",
		"@shadcn-svelte/primitives": "^0.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.20.5",
		"bits-ui": "^2.19.5",
		"cn": "^0.4.0",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.12.0",
		"eslint-plugin-svelte": "^3.23.1",
		"formsnap": "^2.0.1",
		"globals": "^17.13.0",
		"layerchart": "^2.7.0",
		"mdsvex": "^0.12.8",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^2.31.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.4",
		"wrangler": "^4.149.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.55.0"
	}
}
